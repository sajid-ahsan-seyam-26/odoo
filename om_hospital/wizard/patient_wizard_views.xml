<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_patient_wizard_form" model="ir.ui.view">
    <field name="name">hospital.patient.wizard.form</field>
    <field name="model">hospital.patient.wizard</field>
    <field name="arch" type="xml">
        <form string="Assign WordBoy">
            <group>
                <field name="patient_id"/>
                <field name="wordboy_id"/>
            </group>

            <footer>
                <button name="action_confirm"
                        string="Confirm korun"
                        type="object"
                        />
                <button name="action_print_pdf"
                        string="PDF print korun"
                        type="object"
                        />

            <button string="Cancel korun"
                       special="cancel"

            />


            </footer>
        </form>
    </field>
</record>
</odoo>
