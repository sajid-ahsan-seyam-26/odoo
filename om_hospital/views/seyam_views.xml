<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- =========================
         List View
    ========================== -->
    <record id="view_seyam_list" model="ir.ui.view">
        <field name="name">seyam.list</field>
        <field name="model">seyam</field>

        <field name="arch" type="xml">
            <list string="Seyam">

                <field name="name"/>
                <field name="employee_id"/>
                <field name="position"/>
                <field name="postcode"/>

            </list>
        </field>
    </record>


    <!-- =========================
         Form View
    ========================== -->
    <record id="view_seyam_form" model="ir.ui.view">
        <field name="name">seyam.form</field>
        <field name="model">seyam</field>

        <field name="arch" type="xml">
            <form string="Seyam">

                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="position"/>
                        <field name="postcode"/>

                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- =========================
         Action
    ========================== -->
    <record id="action_seyam" model="ir.actions.act_window">

        <field name="name">Seyam</field>
        <field name="res_model">seyam</field>
        <field name="view_mode">list,form</field>

    </record>


    <!-- =========================
         Menu
    ========================== -->

    <menuitem
        id="menu_seyam_root"
        name="Seyam"
        sequence="10"
    />

    <menuitem
        id="menu_seyam"
        name="Employees"
        parent="menu_seyam_root"
        action="action_seyam"
        sequence="10"
    />

</odoo>