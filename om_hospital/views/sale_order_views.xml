<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.confirmed.user</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='payment_term_id']"
                   position="after">
                <field name="confirmed_user_id"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']"
                   position="after">
                <field name="patient_id"
                       options="{'no_create': True}"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='tax_ids']"
                   position="after">
                <field name="extra_item"
                       invisible="display_type"/>
                <field name="payment_method"
                       optional="show"
                       />
            </xpath>

        </field>
    </record>
</odoo>
