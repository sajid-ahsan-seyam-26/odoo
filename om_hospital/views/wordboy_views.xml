<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- WordBoy List View -->
    <record id="view_wordboy_list" model="ir.ui.view">
        <field name="name">wordboy.list</field>
        <field name="model">wordboy</field>
        <field name="arch" type="xml">

            <list string="WordBoy"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'draft'">

                <field name="name"/>

                <!-- Contact er naam and avatar -->
                <field name="partner_id"
                       widget="many2one_avatar"
                       optional="show"/>

                <!-- Responsible user er naam and avatar -->
                <field name="user_id"
                       widget="many2one_avatar_user"
                       optional="show"/>

                <field name="registration_number" optional="show"/>
                <field name="phone" widget="phone" optional="show"/>
                <field name="joining_date" optional="show"/>

                <field name="priority"
                       widget="badge"
                       optional="show"
                       decoration-muted="priority == '0'"
                       decoration-info="priority == '1'"
                       decoration-warning="priority == '2'"
                       decoration-danger="priority == '3'"/>

                <field name="state"
                       widget="badge"
                       optional="show"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'done'"/>

                <!-- emergency contact number dekhabe -->
                <field name="address" optional="hide"/>
                <field name="emergency_contact_name" optional="hide"/>

                <field name="emergency_contact_phone"
                       widget="phone"
                       optional="hide"/>

                <field name="emergency_contact_relation" optional="hide"/>

                <field name="emergency_contract_number"
                       widget="phone"
                       optional="hide"/>

            </list>

        </field>
    </record>

    <!-- WordBoy Form View -->
    <record id="view_wordboy_form" model="ir.ui.view">
        <field name="name">wordboy.form</field>
        <field name="model">wordboy</field>
        <field name="arch" type="xml">

            <form string="WordBoy">

                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            confirm="Are you sure you want to mark this WordBoy as Done?"
                            invisible="state == 'done'"/>

                    <button name="action_reset"
                            string="Reset"
                            type="object"
                            class="btn-secondary"
                            confirm="Are you sure you want to reset this WordBoy?"
                            invisible="state == 'draft'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,done"/>
                </header>

                <sheet>

                    <field name="image"
                           widget="image"
                           class="oe_avatar"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="Enter WordBoy name"/>
                        </h1>
                    </div>

                    <group>

                        <group string="Personal Information">
                            <field name="registration_number"/>

                            <field name="phone"
                                   widget="phone"
                                   placeholder="Enter phone number"/>

                            <field name="address"
                                   placeholder="Enter full address"/>

                            <field name="joining_date"/>
                        </group>

                        <group string="Assignment">
                            <field name="partner_id"
                                   widget="many2one_avatar"/>

                            <field name="user_id"
                                   widget="many2one_avatar_user"/>

                            <field name="priority"/>

                            <field name="state"
                                   widget="badge"
                                   decoration-muted="state == 'draft'"
                                   decoration-success="state == 'done'"/>
                        </group>

                    </group>

                    <group string="Sales Information" groups="sales_team.group_sale_salesman">
                        <field name="sale_order_id" options="{'no_create': True}"/>
                        <field name="sale_customer_id"/>
                        <field name="sale_order_date"/>
                    </group>

                    <group string="Emergency Contact">
                        <group>
                            <field name="emergency_contact_name"
                                   placeholder="Enter contact person's name"/>

                            <field name="emergency_contact_phone"
                                   widget="phone"
                                   placeholder="Enter emergency phone number"/>
                        </group>

                        <group>
                            <field name="emergency_contact_relation"
                                   placeholder="e.g. Father, Mother, Brother"/>

                            <field name="emergency_contract_number"
                                   string="Emergency Number (Old)"
                                   widget="phone"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert">
                        <strong>Help:</strong>
                        <p>
                            Enter the WordBoy name and registration number.
                            Add a photo, phone number, address, joining date,
                            and emergency contact details.
                            Select a contact, responsible user, and priority.
                            Click Confirm to mark this record as Done.
                        </p>
                    </div>

                    <div class="alert alert-success"
                         role="alert"
                         invisible="state != 'done'">
                        <strong>Congratulations!</strong>
                        <p>
                            You have successfully completed this WordBoy.
                        </p>
                    </div>

                    <div class="alert alert-warning"
                         role="alert"
                         invisible="state != 'draft'">
                        <strong>Status:</strong>
                        <p>
                            This WordBoy is currently in Draft state.
                        </p>
                    </div>

                </sheet>

                <!-- Messages ebong activities -->
                <chatter/>

            </form>

        </field>
    </record>

    <!-- WordBoy Search View -->
    <record id="view_wordboy_search" model="ir.ui.view">
        <field name="name">wordboy.search</field>
        <field name="model">wordboy</field>
        <field name="arch" type="xml">

            <search string="Search WordBoy">

                <field name="name"/>
                <field name="registration_number"/>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="priority"/>
                <field name="state"/>

                <filter name="filter_done"
                        string="Done"
                        domain="[('state', '=', 'done')]"/>

                <filter name="filter_draft"
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>

                <separator/>

                <filter name="filter_high_priority"
                        string="High Priority"
                        domain="[('priority', '=', '3')]"/>

                <filter name="filter_medium_priority"
                        string="Medium Priority"
                        domain="[('priority', '=', '2')]"/>

                <filter name="filter_low_priority"
                        string="Low Priority"
                        domain="[('priority', '=', '1')]"/>

                <filter name="filter_normal_priority"
                        string="Normal Priority"
                        domain="[('priority', '=', '0')]"/>

            </search>

        </field>
    </record>

    <!-- Window Action -->
    <record id="action_wordboy" model="ir.actions.act_window">
        <field name="name">WordBoy</field>
        <field name="res_model">wordboy</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wordboy_search"/>
    </record>

</odoo>