<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_hospital_helicopter_form" model="ir.ui.view">
        <field name="name">hospital.helicopter.form</field>
        <field name="model">hospital.helicopter</field>
        <field name="arch" type="xml">
            <form string="Helicopter">
                <header>
                    <button name="action_open_website"
                            type="object"
                            string="Find your helicopter"/>

                    <button name="action_video"
                            type="object"
                            string="open video"/>

                    <button name="action_share_whatsapp"
                            type="object"
                            string="WhatsApp"/>

                    <button name="action_helicopter"
                            type="object"
                            string="Helicopter"/>

                    <button name="action_send_email"
                            type="object"
                            string="Send Email"/>

                    <button name="action_active"
                            type="object"
                            string="active"/>

                    <button name="action_draft"
                            type="object"
                            string="draft"/>

                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="helicopter" widget="radio"/>
                        <field name="hourly_rate"/>
                        <field name="rental_rate"/>
                        <field name="total_cost"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_hospital_helicopter_list" model="ir.ui.view">
        <field name="name">hospital.helicopter.list</field>
        <field name="model">hospital.helicopter</field>
        <field name="arch" type="xml">

            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'draft'"/>

                <button name="action_active"
                        type="object"
                        icon="fa-check"
                        class="btn-success"
                        title="Active"/>

                <button name="action_draft"
                        type="object"
                        icon="fa-times"
                        class="btn-danger"
                        title="Draft"/>
            </list>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_hospital_helicopter" model="ir.actions.act_window">
        <field name="name">Helicopter</field>
        <field name="res_model">hospital.helicopter</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Email Template -->
    <record id="helicopter_email" model="mail.template">
        <field name="name">Helicopter Email</field>
        <field name="model_id" ref="model_hospital_helicopter"/>
        <field name="subject">Helicopter Booking</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="body_html" type="html">
            <p>
            Helicopter booking details:
        </p>
        </field>
    </record>

</odoo>