<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_doctor" model="ir.actions.report">
        <field name="name">Doctor Information</field>
        <field name="model">hospital_doctor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">om_hospital.report_doctor</field>
        <field name="binding_model_id" ref="model_hospital_doctor"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Doctor - %s' % object.name</field>
    </record>

    <template id="report_doctor">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Doctor Information</h2>

                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th>Doctor Name</th>
                                    <td><span t-field="o.name"/></td>
                                </tr>
                                <tr>
                                    <th>Doctor ID</th>
                                    <td><span t-field="o.doctor_code"/></td>
                                </tr>
                                <tr>
                                    <th>Specialization</th>
                                    <td><span t-field="o.specialization"/></td>
                                </tr>
                                <tr>
                                    <th>Qualification</th>
                                    <td><span t-field="o.qualification"/></td>
                                </tr>
                                <tr>
                                    <th>Medical Registration No.</th>
                                    <td><span t-field="o.registration_number"/></td>
                                </tr>
                                <tr>
                                    <th>Experience (Years)</th>
                                    <td><span t-field="o.experience"/></td>
                                </tr>
                                <tr>
                                    <th>Consultation Fee</th>
                                    <td><span t-field="o.consultation_fee"/></td>
                                </tr>
                                <tr>
                                    <th>Phone</th>
                                    <td><span t-field="o.phone"/></td>
                                </tr>
                                <tr>
                                    <th>Email</th>
                                    <td><span t-field="o.email"/></td>
                                </tr>
                                <tr>
                                    <th>Joining Date</th>
                                    <td><span t-field="o.joining_date"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Assigned Patients</h3>

                        <t t-if="o.patient_ids">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>SL</th>
                                        <th>Patient Name</th>
                                        <th>Age</th>
                                        <th>Gender</th>
                                        <th>Phone</th>
                                        <th>Email</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.patient_ids" t-as="patient">
                                        <tr>
                                            <td>
                                                <span t-out="patient_index + 1"/>
                                            </td>
                                            <td>
                                                <span t-field="patient.name"/>
                                            </td>
                                            <td>
                                                <span t-field="patient.age"/>
                                            </td>
                                            <td>
                                                <span t-field="patient.gender"/>
                                            </td>
                                            <td>
                                                <span t-field="patient.phone"/>
                                            </td>
                                            <td>
                                                <span t-field="patient.email"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>


                        </t>
                        <t t-else="">
                            <p>kono patient assign kora hoi nai.</p>
                        </t>

                        <t t-if="o.notes">
                            <h4>Notes</h4>
                            <div t-field="o.notes"
                                 style="white-space: pre-wrap;"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>